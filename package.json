{
  "name": "dsh-session-recall",
  "version": "0.1.1",
  "description": "Bounded, model-free session chronicle for DeepSeek Harness, plus a switch that turns on the harness's own workspace-authorized session history tools.",
  "type": "module",
  "main": "lib/chronicle.js",
  "exports": {
    ".": "./lib/chronicle.js",
    "./chronicle": "./lib/chronicle.js",
    "./service": "./lib/service.js",
    "./tool": "./lib/tool.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "scripts/check.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "session",
    "history",
    "chronicle",
    "memory",
    "recall",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingzoudefengye/dsh-session-recall.git"
  },
  "license": "MIT"
}
